# Dependencies
node_modules/

# Local npm cache, used only when the machine's global npm cache is not
# writable (e.g. a sandboxed install). A normal `npm install` never creates it.
.npm-cache/

# Build output
dist/
dist-ssr/
*.local

# Test / coverage output
coverage/

# ESLint cache (only created when lint is run with --cache)
.eslintcache

# Logs
*.log
npm-debug.log*

# Local env
.env
.env.*

# Editor and OS cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
