# Dependencies
node_modules/

# Local npm cache, used only when the machine's global npm cache is not
# writable (e.g. a sandboxed install). A normal `npm install` never creates it.
.npm-cache/

# Build output
dist/
dist-ssr/
*.local

# Test / coverage output
coverage/

# ESLint cache (only created when lint is run with --cache)
.eslintcache

# `gh` CLI cache, used only when the machine's default cache dir is not writable.
# Never part of the project; it is a tool artifact.
.gh-cache/

# MediaPipe WASM bundle. Copied out of the pinned @mediapipe/tasks-vision package
# by `npm run assets:sync`, which dev and build run automatically, so it is
# derived rather than source. The .task model in public/models/ IS committed,
# because it is not published on npm and a fresh clone should run without a
# network fetch.
public/wasm/

# Logs
*.log
npm-debug.log*

# Local env
.env
.env.*

# Editor and OS cruft
.DS_Store
Thumbs.db
.idea/
.vscode/
